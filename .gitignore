# Local runtime data and secrets
.env
*.log
sessions/
loot/
reports/
results/
workspace/

# Run artifacts (never commit recon output)
runs/

# Local Pi/runtime state
.runtime/

# Local browser automation data (may contain cookies and login tokens)
/.browser-profile/

# Accidental Windows null-device output
/nul

# Python virtual environment and build/test caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Node.js dependencies
node_modules/
